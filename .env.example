# Server
PORT=3000
NODE_ENV=development
ENCRYPTION_KEY=<32字节hex密钥>
# 反向代理跳数。默认 1 = 只信任本机 nginx（线上部署形态）；
# 前面若再加一层云负载均衡/CDN，需要相应调大，否则限流拿不到真实客户端 IP。
TRUST_PROXY=1
DB_MYSQL_HOST=mysql
DB_MYSQL_PORT=3306
DB_MYSQL_USER=ai_cast
DB_MYSQL_PASSWORD=ai_cast_pass
DB_MYSQL_DATABASE=ai_cast_hub
DB_SQLITE_PATH=./data/local.db

# Coturn（TURN 中继）
#
# 未部署 coturn 时【三个都留空】。留空即不下发 TURN，客户端只用公共 STUN；
# 切勿填 turn:localhost:3478 之类的占位值 —— ICE 会去连一个永远不通的地址并
# 等到超时，比干脆不给 TURN 更慢（详见 server/src/config/index.js 注释）。
#
# TURN_SERVER 支持逗号分隔的多个传输方式，企业网络封 UDP 时靠 TCP/TLS 兜底：
#   TURN_SERVER=turn:your.domain:3478?transport=udp,turn:your.domain:3478?transport=tcp
#   TURN_SERVER=turn:your.domain:3478?transport=udp,turn:your.domain:3478?transport=tcp,turns:your.domain:5349?transport=tcp
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Docker Sandbox
SANDBOX_IMAGE=ai-cast-sandbox:latest
SANDBOX_TIMEOUT_SEC=120
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_COUNT=1

# SSL
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
