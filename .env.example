# Server
PORT=3000
NODE_ENV=development
ENCRYPTION_KEY=<32字节hex密钥>
DB_MYSQL_HOST=mysql
DB_MYSQL_PORT=3306
DB_MYSQL_USER=ai_cast
DB_MYSQL_PASSWORD=ai_cast_pass
DB_MYSQL_DATABASE=ai_cast_hub
DB_SQLITE_PATH=./data/local.db

# Coturn
TURN_SERVER=turn:localhost:3478
TURN_USERNAME=ai_cast
TURN_CREDENTIAL=ai_cast_turn

# Docker Sandbox
SANDBOX_IMAGE=ai-cast-sandbox:latest
SANDBOX_TIMEOUT_SEC=120
SANDBOX_MEMORY_MB=512
SANDBOX_CPU_COUNT=1

# SSL
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
